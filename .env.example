# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_CONFIGURATION: Fill in these details to automatically activate Supabase PostgreSQL backend.
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# APPWRITE_CONFIGURATION: Fill in these details to automatically activate Appwrite BaaS backend.
VITE_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
VITE_APPWRITE_PROJECT="YOUR_APPWRITE_PROJECT_ID"
VITE_APPWRITE_DATABASE_ID="YOUR_APPWRITE_DATABASE_ID"

# LOCAL DEVELOPER SETTINGS:
# Set to 'true' to run the local server using secure HTTPS.
# This enables Webcam, Biometrics/Face ID, and Google Sign-In when testing locally on different devices or on localhost.
USE_HTTPS=false

# ADMIN PANEL CREDENTIALS & SECURITY:
# Configures the master super-admin username and password for /admin/login
ADMIN_USERNAME="BSMI123ANATOMY"
ADMIN_PASSWORD="anatomy123bsmi"

# ADMIN AI CHAT MASTER SECURITY CODE:
# Required by the admin AI assistant to execute sensitive write/delete administrative operations
ADMIN_SECRET_CODE="qwsxazxc123"

# FACE ID (biometric login) SETTINGS — optional, sensible defaults are built in.
# Face ID needs GEMINI_API_KEY above; without it every verification is denied.
# FACE_MATCH_THRESHOLD: minimum identity-match confidence (0.5–0.99 or 50–99). Default 0.75.
# FACE_ID_MODELS: comma-separated Gemini models tried in order (each has its own quota).
# GEMINI_API_KEYS: optional comma-separated list of extra keys (ideally from different Google
# Cloud projects / billing accounts). Tried in order before GEMINI_API_KEY; a key whose billing
# account is suspended or whose free-tier quota is exhausted no longer blocks Face ID.
# GEMINI_API_KEYS=AIza...projectA,AIza...projectB
# FACE_MATCH_THRESHOLD=0.75
# FACE_ID_MODELS=gemini-2.5-flash,gemini-3.7-flash,gemini-flash-latest,gemini-3.1-flash-lite



