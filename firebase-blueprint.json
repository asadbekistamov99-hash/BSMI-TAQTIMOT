{
  "entities": {
    "topic": {
      "title": "Topic",
      "description": "An anatomy topic within a semester",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "semester": { "type": "number", "description": "1 or 2" },
        "order": { "type": "number", "description": "1 to 13" },
        "title": { "type": "string" },
        "theory": { "type": "string" },
        "latinTerms": { "type": "array", "items": { "type": "string" } },
        "image": { "type": "string", "format": "uri" },
        "videos": { "type": "array", "items": { "type": "string", "format": "uri" } }
      },
      "required": ["semester", "order", "title", "theory"]
    },
    "quiz": {
      "title": "Quiz",
      "description": "A quiz question for a specific topic",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "topicId": { "type": "string" },
        "question": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "correctAnswerIndex": { "type": "number" },
        "explanation": { "type": "string" }
      },
      "required": ["topicId", "question", "options", "correctAnswerIndex", "explanation"]
    },
    "atlas": {
      "title": "Atlas Entry",
      "description": "An entry in the anatomical atlas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "latinName": { "type": "string" },
        "uzbekName": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string", "format": "uri" }
      },
      "required": ["latinName", "uzbekName", "description"]
    },
    "user": {
      "title": "User",
      "description": "Profile information for a student",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastViewedPage": {
          "type": "object",
          "description": "Last page viewed by user to resume session"
        }
      }
    },
    "badge": {
      "title": "Badge",
      "description": "An earned user achievement badge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameUz": { "type": "string" },
        "nameRu": { "type": "string" },
        "nameEn": { "type": "string" },
        "descUz": { "type": "string" },
        "descRu": { "type": "string" },
        "descEn": { "type": "string" },
        "icon": { "type": "string" },
        "earned": { "type": "boolean" },
        "earnedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nameUz", "earned"]
    },
    "pomodoro_session": {
      "title": "Pomodoro Session",
      "description": "Completed deep work study session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "topicTitle": { "type": "string" },
        "durationMinutes": { "type": "integer" },
        "completedAt": { "type": "string", "format": "date-time" },
        "mode": { "type": "string" }
      },
      "required": ["id", "durationMinutes", "completedAt"]
    },
    "weekly_goal": {
      "title": "Weekly Goal",
      "description": "User target study hours per week",
      "type": "object",
      "properties": {
        "targetHours": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["targetHours"]
    },
    "osce_result": {
      "title": "OSCE Exam Result",
      "description": "Completed practical OSCE station exam result",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "stationId": { "type": "string" },
        "stationTitle": { "type": "string" },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "passed": { "type": "boolean" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "stationId", "score"]
    },
    "leaderboard_entry": {
      "title": "Leaderboard Entry",
      "description": "Aggregated points and achievements for student ranking",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "academicGroup": { "type": "string" },
        "totalScore": { "type": "number" },
        "pomodoroMinutes": { "type": "number" },
        "quizzesCompleted": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "totalScore"]
    },
    "flashcard": {
      "title": "Flashcard",
      "description": "A flashcard review state and favorite indicator for a term",
      "type": "object",
      "properties": {
        "termId": { "type": "string" },
        "isFavorite": { "type": "boolean" },
        "interval": { "type": "number" },
        "repetitions": { "type": "number" },
        "easeFactor": { "type": "number" },
        "nextReview": { "type": "string" }
      }
    },
    "payment": {
      "title": "Payment",
      "description": "Subscription payment record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "rejected"] },
        "image": { "type": "string", "format": "uri", "description": "Receipt image" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "admin": {
      "title": "Admin",
      "description": "Privileged administrator access record",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "settings": {
      "title": "App Settings",
      "description": "Global application settings",
      "type": "object",
      "properties": {
        "design": { "type": "object" }
      }
    },
    "announcement": {
      "title": "Announcement",
      "description": "Global announcements and notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "warning", "success", "danger"] },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "type", "isActive"]
    },
    "midterm": {
      "title": "Midterm File",
      "description": "Uploaded exam file (e.g. DOCX) for a semester",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "topicId": { "type": "string", "enum": ["midterm_1", "midterm_2"] },
        "fileName": { "type": "string" },
        "fileUrl": { "type": "string", "format": "uri" },
        "fileType": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["topicId", "fileName", "fileUrl"]
    },
    "semester": {
      "title": "Semester",
      "description": "A semester record for organizing topics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "number" },
        "title": { "type": "object" },
        "description": { "type": "object" },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["number", "title"]
    },
    "anatomy_model": {
      "title": "Anatomy 3D Model",
      "description": "An interactive 3D model of an anatomical structure",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "object" },
        "description": { "type": "object" },
        "system": { "type": "string" },
        "region": { "type": "string" },
        "embedUrl": { "type": "string" },
        "fileUrl": { "type": "string" },
        "thumbnail": { "type": "string" },
        "source": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "license": { "type": "string" },
        "author": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "pins": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["id", "title", "system"]
    },
    "academic_group": {
      "title": "Academic Group",
      "description": "Student study group for collaborative leaderboard and rankings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "groupName": { "type": "string" },
        "faculty": { "type": "string" },
        "description": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "groupCode": { "type": "string" },
        "members": { "type": "array", "items": { "type": "object" } },
        "totalScore": { "type": "number" },
        "membersCount": { "type": "number" },
        "avgAccuracy": { "type": "number" },
        "topStudent": { "type": "string" }
      },
      "required": ["groupName", "faculty"]
    },
    "pin_quiz": {
      "title": "Pin Quiz Diagram",
      "description": "Anatomical visual specimen with interactive numbered pins for practical skill tests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "object" },
        "system": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Oson", "O'rta", "Murakkab"] },
        "customImageUrl": { "type": "string" },
        "imageBackdrop": { "type": "string" },
        "description": { "type": "string" },
        "pins": { "type": "array", "items": { "type": "object" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "title", "system", "pins"]
    },
    "latin_term": {
      "title": "Latin Glossary Term",
      "description": "Anatomical Latin glossary term with multi-language translations and topic classification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "latin": { "type": "string" },
        "uzbek": { "type": "string" },
        "russian": { "type": "string" },
        "english": { "type": "string" },
        "semester": { "type": "number", "description": "Semester 1, 2, or 3" },
        "topicOrder": { "type": "number", "description": "Topic number 1 to 13" },
        "description": { "type": "string" },
        "pronunciation": { "type": "string" },
        "isDeleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["latin", "uzbek"]
    }
  },
  "firestore": {
    "latin_terms": {
      "schema": "latin_term",
      "description": "Collection of anatomical Latin glossary terms"
    },
    "pin_quizzes": {
      "schema": "pin_quiz",
      "description": "Collection of anatomical Pin Test specimens and numbered pins"
    },
    "academic_groups": {
      "schema": "academic_group",
      "description": "Collection of academic study groups"
    },
    "topics": {
      "schema": "topic",
      "description": "Collection of anatomy topics"
    },
    "quizzes": {
      "schema": "quiz",
      "description": "Collection of quiz questions"
    },
    "atlas": {
      "schema": "atlas",
      "description": "Collection of atlas entries"
    },
    "anatomy_models": {
      "schema": "anatomy_model",
      "description": "Collection of interactive 3D anatomy models"
    },
    "users": {
      "schema": "user",
      "description": "Student user profiles"
    },
    "users/{userId}/flashcards/{flashcardId}": {
      "schema": "flashcard",
      "description": "Flashcard state/favorites for a specific user"
    },
    "users/{userId}/badges/{badgeId}": {
      "schema": "badge",
      "description": "Earned badges for a specific user"
    },
    "users/{userId}/pomodoro_sessions/{sessionId}": {
      "schema": "pomodoro_session",
      "description": "Completed study timer sessions for a specific user"
    },
    "payments": {
      "schema": "payment",
      "description": "Payment records for subscriptions"
    },
    "admins": {
      "schema": "admin",
      "description": "List of administrators"
    },
    "settings": {
      "schema": "settings",
      "description": "Configuration and design settings"
    },
    "announcements": {
      "schema": "announcement",
      "description": "List of global announcements"
    },
    "midterms": {
      "schema": "midterm",
      "description": "Exam files for semesters"
    },
    "semesters": {
      "schema": "semester",
      "description": "Collection of academic semesters"
    }
  }
}
