rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == "asadbekistamov99@gmail.com" ||
          request.auth.token.email.lower().matches('.*admin.*')
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        ))
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Collections ---

    match /semesters/{semesterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /atlas/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /anatomy_models/{modelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && 
         request.resource.data.isAdmin == false && 
         request.resource.data.role == 'user' && 
         request.resource.data.isBlocked == false) || 
        isAdmin()
      );
      
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['purchasedSemesters', 'isAdmin', 'isBlocked', 'role'])
        )
      );
      
      allow delete: if isAdmin();

      match /flashcards/{flashcardId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /badges/{badgeId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /pomodoro_sessions/{sessionId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /goals/{goalId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /osce_results/{resultId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == entryId || isAdmin());
    }

    match /academic_groups/{groupId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /biometric_audit/{auditId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /payments/{paymentId} {
      allow get: if isSignedIn() && (isAdmin() || paymentId.matches('^' + request.auth.uid + '.*'));
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource.data.userId == request.auth.uid && 
          resource.data.status != 'approved' && 
          resource.data.status != 'completed' &&
          request.resource.data.status == 'pending' &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'adminNote', 'amount'])
        )
      );
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /latin_terms/{termId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /midterms/{midtermId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pin_quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
